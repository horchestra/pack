# the node's tags and its raft log (docs/configuration.md); the file --config / TEMBO_CONFIG loads
TEMBO_RAFT_RETENTION_LOG_SIZE={{ .raft_retention_log_size }}
{{ if .nofailover }}TEMBO_NOFAILOVER=true
{{ end }}{{ if .nosync }}TEMBO_NOSYNC=true
{{ end }}{{ if .failover_priority }}TEMBO_FAILOVER_PRIORITY={{ .failover_priority }}
{{ end }}
