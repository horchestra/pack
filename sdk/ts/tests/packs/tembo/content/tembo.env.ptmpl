# the node's tags and its raft log (docs/configuration.md); the file --config / TEMBO_CONFIG loads
TEMBO_RAFT_RETENTION_LOG_SIZE={{ .node.raft_retention_log_size }}
{{ if .node.nofailover }}TEMBO_NOFAILOVER=true
{{ end }}{{ if .node.nosync }}TEMBO_NOSYNC=true
{{ end }}{{ if .node.failover_priority }}TEMBO_FAILOVER_PRIORITY={{ .node.failover_priority }}
{{ end }}
