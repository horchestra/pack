{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "daemon": {
      "additionalProperties": false,
      "properties": {
        "log-driver": {
          "default": "json-file",
          "type": "string"
        },
        "log-opts": {
          "additionalProperties": false,
          "properties": {
            "max-file": {
              "default": "3",
              "type": "string"
            },
            "max-size": {
              "default": "50m",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "log-opts"
      ],
      "type": "object"
    },
    "mirror": {
      "default": "https://download.docker.com/linux",
      "type": "string"
    }
  },
  "required": [
    "daemon"
  ],
  "type": "object",
  "x-pack": {
    "packages": {
      "debian": {
        "content": [
          {
            "format": "json",
            "mode": "0644",
            "path": "/etc/docker/daemon.json",
            "values": "daemon"
          }
        ],
        "names": [
          "docker-ce",
          "docker-ce-cli",
          "containerd.io",
          "docker-buildx-plugin",
          "docker-compose-plugin"
        ],
        "prepare": [
          "ca-certificates"
        ],
        "repo": [
          {
            "mode": "0644",
            "path": "/etc/apt/keyrings/docker.asc",
            "url": "{{ .mirror }}/debian/gpg"
          },
          {
            "mode": "0644",
            "path": "/etc/apt/sources.list.d/docker.sources",
            "template": "docker.sources"
          }
        ],
        "services": [
          "docker"
        ]
      },
      "fedora": {
        "content": [
          {
            "format": "json",
            "mode": "0644",
            "path": "/etc/docker/daemon.json",
            "values": "daemon"
          }
        ],
        "names": [
          "docker-ce",
          "docker-ce-cli",
          "containerd.io",
          "docker-buildx-plugin",
          "docker-compose-plugin"
        ],
        "repo": [
          {
            "mode": "0644",
            "path": "/etc/yum.repos.d/docker-ce.repo",
            "template": "docker-ce.repo"
          }
        ],
        "services": [
          "docker"
        ]
      }
    }
  }
}
