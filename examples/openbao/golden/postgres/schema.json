{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "database": {
      "type": "string",
      "title": "Database",
      "description": "The database created at the first start.",
      "examples": [
        "app"
      ],
      "x-pack-env": "POSTGRES_DB",
      "x-pack-i18n": {
        "ru": {
          "description": "База, создаваемая при первом запуске.",
          "title": "База данных"
        }
      }
    },
    "superuser": {
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "description": "The superuser's name.",
          "default": "postgres",
          "x-pack-env": "POSTGRES_USER",
          "x-pack-i18n": {
            "ru": {
              "description": "Имя суперпользователя.",
              "title": "Имя"
            }
          }
        },
        "password": {
          "type": "string",
          "format": "password",
          "title": "Password",
          "description": "A reference to the Secret that holds the superuser's password.",
          "x-pack-env": "POSTGRES_PASSWORD",
          "x-pack-i18n": {
            "ru": {
              "description": "Ссылка на Secret с паролем суперпользователя.",
              "title": "Пароль"
            }
          }
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "password"
      ],
      "title": "Superuser",
      "description": "The role the server is bootstrapped with.",
      "x-pack-i18n": {
        "ru": {
          "description": "Роль, с которой инициализируется сервер.",
          "title": "Суперпользователь"
        }
      }
    },
    "conf": {
      "properties": {
        "max_connections": {
          "type": "integer",
          "title": "Max connections",
          "description": "How many client connections the server accepts at once.",
          "default": 100,
          "examples": [
            200
          ],
          "x-pack-group": "server",
          "x-pack-i18n": {
            "ru": {
              "description": "Сколько клиентских соединений сервер принимает одновременно.",
              "title": "Максимум соединений"
            }
          }
        },
        "shared_buffers": {
          "type": "string",
          "title": "Shared buffers",
          "description": "The memory of the shared buffer cache; a quarter of the memory limit unless set.",
          "examples": [
            "1GB"
          ],
          "x-pack-compute": "has(limits.memory) ? string(limits.memory / 1048576 / 4) + 'MB' : '128MB'",
          "x-pack-group": "server",
          "x-pack-i18n": {
            "ru": {
              "description": "Память кэша разделяемых буферов; если не задана — четверть лимита памяти.",
              "title": "Разделяемые буферы"
            }
          }
        },
        "listen_addresses": {
          "type": "string",
          "title": "Listen addresses",
          "description": "The addresses the server listens on; * is every one.",
          "default": "*",
          "x-pack-group": "server",
          "x-pack-i18n": {
            "ru": {
              "description": "Адреса, на которых слушает сервер; * — все.",
              "title": "Адреса"
            }
          }
        },
        "port": {
          "type": "integer",
          "title": "Port",
          "description": "The port the server listens on.",
          "default": 5432,
          "examples": [
            5432
          ],
          "x-pack-group": "server",
          "x-pack-i18n": {
            "ru": {
              "description": "Порт, на котором слушает сервер.",
              "title": "Порт"
            }
          }
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "postgresql.conf",
      "description": "The settings of postgresql.conf, written as they are.",
      "x-pack-group": "server",
      "x-pack-i18n": {
        "ru": {
          "description": "Настройки postgresql.conf, записываются как есть.",
          "title": "postgresql.conf"
        }
      }
    },
    "pgdg": {
      "type": "string",
      "title": "PGDG repository",
      "description": "Where the packages of PGDG come from on a host: upstream by default, a\nmirror when the hosts do not reach it.",
      "default": "https://apt.postgresql.org/pub/repos/apt",
      "x-pack-group": "packages",
      "x-pack-i18n": {
        "ru": {
          "description": "Откуда берутся пакеты PGDG на хосте: по умолчанию из апстрима,\nиз зеркала, если хосты до него не достают.",
          "title": "Репозиторий PGDG"
        }
      }
    },
    "pgdg_key": {
      "type": "string",
      "title": "PGDG key",
      "description": "The signing key of the PGDG repository.",
      "default": "https://www.postgresql.org/media/keys/ACCC4CF8.asc",
      "x-pack-group": "packages",
      "x-pack-i18n": {
        "ru": {
          "description": "Ключ подписи репозитория PGDG.",
          "title": "Ключ PGDG"
        }
      }
    },
    "init_extensions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "title": "Extensions",
      "description": "The extensions every database gets, after the first start.",
      "default": [
        "pg_stat_statements",
        "pgcrypto"
      ],
      "x-pack-i18n": {
        "ru": {
          "description": "Расширения, которые получает каждая база после первого запуска.",
          "title": "Расширения"
        }
      }
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "database",
    "superuser",
    "conf"
  ],
  "title": "PostgreSQL",
  "description": "A single-instance PostgreSQL with an install hook and a major-version upgrade hook.",
  "x-pack": {
    "ports": {
      "pg": 5432
    },
    "data": {
      "data": {
        "mountPath": "/var/lib/postgresql/data",
        "size": "10Gi"
      }
    },
    "content": [
      {
        "path": "/etc/postgresql/postgresql.conf",
        "values": "conf",
        "format": "properties"
      },
      {
        "path": "/opt/pack/init-extensions.sh",
        "template": "init-extensions.sh",
        "mode": "0755"
      },
      {
        "path": "/opt/pack/restore-15.sh",
        "source": "restore-15.sh",
        "mode": "0755"
      }
    ],
    "packages": {
      "debian": {
        "prepare": [
          "ca-certificates"
        ],
        "repo": [
          {
            "path": "/etc/apt/keyrings/pgdg.asc",
            "url": "{{ .pgdg_key }}",
            "mode": "0644"
          },
          {
            "path": "/etc/apt/sources.list.d/pgdg.sources",
            "template": "host-pgdg.sources",
            "mode": "0644"
          }
        ],
        "names": [
          "postgresql-16"
        ],
        "content": [
          {
            "path": "/etc/postgresql/16/main/conf.d/pack.conf",
            "template": "host-postgresql.conf",
            "mode": "0644"
          },
          {
            "path": "/etc/postgresql/16/main/pg_hba.conf",
            "source": "host-pg_hba.conf",
            "mode": "0640"
          },
          {
            "path": "/opt/pack/init-extensions.sh",
            "template": "host-init.sh",
            "mode": "0700"
          }
        ],
        "services": [
          "postgresql@16-main"
        ]
      },
      "fedora": {
        "names": [
          "postgresql-server",
          "postgresql-contrib"
        ],
        "commands": [
          [
            "sh",
            "-c",
            "test -f /var/lib/pgsql/data/PG_VERSION || postgresql-setup --initdb"
          ]
        ],
        "content": [
          {
            "path": "/var/lib/pgsql/data/postgresql.auto.conf",
            "template": "host-postgresql.conf",
            "mode": "0644"
          },
          {
            "path": "/var/lib/pgsql/data/pg_hba.conf",
            "source": "host-pg_hba.conf",
            "mode": "0644"
          },
          {
            "path": "/opt/pack/init-extensions.sh",
            "template": "host-init.sh",
            "mode": "0700"
          }
        ],
        "services": [
          "postgresql"
        ]
      }
    },
    "minimum": {
      "cpu": "500m",
      "memory": "512Mi"
    },
    "readiness": {
      "tcp": "pg"
    },
    "upgrade": {
      "from": "\u003e=15"
    },
    "hooks": [
      {
        "name": "init-extensions",
        "phase": "postInstall",
        "image": "new",
        "command": [
          "/opt/pack/init-extensions.sh"
        ],
        "timeout": "5m",
        "idempotent": true
      },
      {
        "name": "pg-upgrade",
        "phase": "preUpgrade",
        "when": {
          "from": "\u003c16",
          "to": "\u003e=16"
        },
        "image": "new",
        "command": [
          "/usr/lib/postgresql/16/bin/pg_upgrade",
          "--old-bindir=/usr/lib/postgresql/15/bin",
          "--new-bindir=/usr/lib/postgresql/16/bin",
          "--old-datadir=/var/lib/postgresql/data",
          "--new-datadir=/var/lib/postgresql/data.16"
        ],
        "exclusive": true,
        "timeout": "30m",
        "compensate": {
          "image": "old",
          "command": [
            "/opt/pack/restore-15.sh"
          ]
        }
      },
      {
        "name": "analyze",
        "phase": "postUpgrade",
        "when": {
          "to": "\u003e=16"
        },
        "image": "new",
        "command": [
          "vacuumdb",
          "--all",
          "--analyze-in-stages"
        ],
        "idempotent": true
      }
    ]
  },
  "x-pack-actions": [
    {
      "name": "backup",
      "description": "Dumps a database with pg_dump to a file of the instance.",
      "command": [
        "pg_dump",
        "--username={{ .user }}",
        "--format={{ .format }}",
        "--file={{ .to }}",
        "--dbname={{ .database }}"
      ],
      "timeout": "1h",
      "params": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "description": "The database to dump.",
            "default": "postgres",
            "x-pack-i18n": {
              "ru": {
                "description": "База для выгрузки."
              }
            }
          },
          "format": {
            "type": "string",
            "description": "The format of the dump, as pg_dump says it.",
            "default": "custom",
            "enum": [
              "custom",
              "plain",
              "directory"
            ],
            "x-pack-i18n": {
              "ru": {
                "description": "Формат выгрузки, как его называет pg_dump."
              }
            }
          },
          "to": {
            "type": "string",
            "description": "The file (or the directory, of format directory) the dump goes to, in the instance: under /var/lib/postgresql/data it outlives the instance.",
            "x-pack-i18n": {
              "ru": {
                "description": "Файл (или каталог, для формата directory) на экземпляре, куда пишется выгрузка: под /var/lib/postgresql/data она переживёт экземпляр."
              }
            }
          },
          "user": {
            "type": "string",
            "description": "The role the dump is made as.",
            "default": "postgres",
            "x-pack-i18n": {
              "ru": {
                "description": "Роль, от имени которой делается выгрузка."
              }
            }
          }
        },
        "required": [
          "to"
        ],
        "additionalProperties": false
      },
      "x-pack-i18n": {
        "ru": {
          "description": "Выгружает базу через pg_dump в файл на экземпляре."
        }
      }
    },
    {
      "name": "restore",
      "description": "Restores a database from a dump with pg_restore, dropping what it holds first.",
      "command": [
        "pg_restore",
        "--username={{ .user }}",
        "--clean",
        "--if-exists",
        "--dbname={{ .database }}",
        "{{ .from }}"
      ],
      "timeout": "1h",
      "mutating": true,
      "approve": true,
      "params": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "description": "The database to restore into.",
            "default": "postgres",
            "x-pack-i18n": {
              "ru": {
                "description": "База, в которую восстанавливать."
              }
            }
          },
          "from": {
            "type": "string",
            "description": "The dump to restore.",
            "x-pack-i18n": {
              "ru": {
                "description": "Выгрузка для восстановления."
              }
            }
          },
          "user": {
            "type": "string",
            "description": "The role the restore is made as.",
            "default": "postgres",
            "x-pack-i18n": {
              "ru": {
                "description": "Роль, от имени которой идёт восстановление."
              }
            }
          }
        },
        "required": [
          "from"
        ],
        "additionalProperties": false
      },
      "x-pack-i18n": {
        "ru": {
          "description": "Восстанавливает базу из выгрузки через pg_restore, сначала удаляя то, что в ней есть."
        }
      }
    }
  ],
  "x-pack-groups": [
    {
      "id": "server",
      "title": "Server",
      "x-pack-i18n": {
        "ru": {
          "title": "Сервер"
        }
      }
    },
    {
      "id": "packages",
      "title": "Packages",
      "x-pack-i18n": {
        "ru": {
          "title": "Пакеты"
        }
      }
    }
  ],
  "x-pack-i18n": {
    "ru": {
      "description": "PostgreSQL на одном экземпляре с хуком установки и хуком обновления мажорной версии.",
      "title": "PostgreSQL"
    }
  },
  "x-pack-langs": [
    "en",
    "ru"
  ]
}